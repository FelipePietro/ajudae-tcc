APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Railway: defina LOG_CHANNEL=stderr no servico para enviar logs ao painel.
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Railway: DB_CONNECTION=mysql e referencias DB_* somente no painel.
# Nao combine DB_URL com DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD:
# a URL tem precedencia. Nunca cole referencias Railway neste arquivo local.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ajudae
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENT_PRIVATE_DISK=local
IMAGE_STORAGE_DISK=image_local
# Railway private bucket (set only after configuring the S3 variables below):
# IMAGE_STORAGE_DISK=railway_images
# DOCUMENT_PRIVATE_DISK=railway_private
QUEUE_CONNECTION=database
# Railway sem worker: QUEUE_CONNECTION=sync; reavaliar antes de usar filas.

CACHE_STORE=database
# Railway: cache database e sessions database exigem migrations iniciais.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
# O bucket pode expor AWS_ENDPOINT_URL/AWS_S3_BUCKET_NAME no CLI; o Laravel
# deste projeto le AWS_ENDPOINT/AWS_BUCKET. Mapear no painel, sem segredos aqui.
# Use the URL style shown on this bucket's Railway Credentials tab.
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
